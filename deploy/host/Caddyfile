# Installed to /mnt/HC_Volume_107333377/cloudreve/caddy/conf/Caddyfile by deploy.py and
# directory-mounted into the caddy container as /etc/caddy/Caddyfile.
# SITE_ADDRESS comes from the caddy.container unit.

# Caddy's admin API stays on its default, localhost:2019 inside the container's own network
# namespace: unreachable from other containers or the host, and needed for zero-downtime
# `caddy reload`.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		# Browsers remember to use HTTPS for a year, so a downgrade attack has no window.
		Strict-Transport-Security "max-age=31536000"
		# Hide the proxy's identity; Cloudreve sets its own content-type headers.
		-Server
	}

	# basement owns its own API namespace (design doc, 7.1). Feature areas it takes over
	# from Cloudreve later get their /api/v4/<area>/* route added here, one line each.
	handle /api/basement/* {
		reverse_proxy basement:8080
	}

	# Android builds for sideloading, published by `deploy.py apk`. Public, read-only,
	# no directory listing: only the files the deploy wrote (index.html, latest.json,
	# the kept APKs) are reachable. The APK is a build of this public repository.
	redir /apk /apk/ 301
	handle_path /apk/* {
		root * /srv/apk
		@apk path *.apk
		# Android's browser only offers "Install" for this exact type; the container's
		# Go mime table does not know .apk.
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Cache-Control "no-cache"
		header /latest.json Cache-Control "no-cache"
		file_server
	}

	# Everything else is Cloudreve: its API, the SPA, WebDAV.
	handle {
		reverse_proxy cloudreve:5212 {
			# Do not buffer responses: file downloads and previews stream straight through.
			flush_interval -1
		}
	}

	log {
		output stderr
		format console
	}
}
