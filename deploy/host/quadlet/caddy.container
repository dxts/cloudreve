# Caddy: TLS termination with automatic Let's Encrypt certificates, reverse proxy to
# Cloudreve over the private network. Runs rootless; binding 80/443 is allowed by the
# net.ipv4.ip_unprivileged_port_start sysctl set in bootstrap.sh.

[Unit]
Description=Caddy reverse proxy for Cloudreve
Wants=network-online.target cloudreve.service
After=network-online.target cloudreve.service
RequiresMountsFor=/mnt/HC_Volume_107333377

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=cloudreve.network

PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

# Mount the directory, not the file. deploy.py replaces the Caddyfile atomically (temp file
# then mv), which changes the inode; a single-file bind mount stays pinned to the old inode
# and `caddy reload` would re-read stale content forever. A directory mount follows the
# rename, so a Caddyfile-only deploy is a true zero-downtime reload.
Volume=/mnt/HC_Volume_107333377/cloudreve/caddy/conf:/etc/caddy:ro
# Certificates and ACME account live in /data; losing them only costs a re-issue.
Volume=/mnt/HC_Volume_107333377/cloudreve/caddy/data:/data
Volume=/mnt/HC_Volume_107333377/cloudreve/caddy/config:/config
# Android builds served at /apk/ (see Caddyfile); written by `deploy.py apk`.
Volume=/mnt/HC_Volume_107333377/cloudreve/apk:/srv/apk:ro

Environment=SITE_ADDRESS=drive.offlike.net

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
# Reload Caddyfile without dropping connections: systemctl --user reload caddy
ExecReload=/usr/bin/podman exec caddy caddy reload --config /etc/caddy/Caddyfile

[Install]
WantedBy=default.target
